{
  "name": "hackathon-stylingu",
  "main": "frontend/dist/free-worker.mjs",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./deploy/vision-assets",
    "binding": "VISION_ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_URL": "https://zbfxwbuuuzjzmsrraxkf.supabase.co/functions/v1/stylingu-api",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFyiycbgRQEQ11_9"
  },
  "exports": {
    "StylinguContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "API_GUARD",
      "namespace_id": "7101",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_GUARD",
      "namespace_id": "7102",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
