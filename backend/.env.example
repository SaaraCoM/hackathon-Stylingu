# Template only. Runtime secrets are injected from Cloudflare Secrets Store or process memory.
NODE_ENV=development
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
RELEASE_VERSION=development
TRUST_PROXY=0
DATABASE_URL=
JOBS_DATABASE_URL=
DB_ROLE=stylingu_api
PG_SSL_CA=
PG_POOL_MAX=3
PG_PORT=5433
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=stylingu-photos
# Compatibility name only; do not supply a legacy service_role key in new deployments.
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=meta
MODEL_API_KEY=
META_AI_API_KEY=
ANALYSIS_DAILY_LIMIT=10
# Explicit integration tests only. Paths to synthetic images, never committed personal photos.
FLOW_FACE=
FLOW_BODY=
# Protected infrastructure runner (not container runtime).
DEPLOY_ENV=staging
DEPLOY_SLOT=blue
BOOTSTRAP=false
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
AUTH_HOOK_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_SECRET_STORE_ID=
CF_ROTATION_TOKEN=
SUPABASE_ROTATION_TOKEN=
ROTATION_DATABASE_URL=
MIGRATION_DATABASE_URL=
ROTATION_GITHUB_TOKEN=
CF_CURRENT_TOKEN_ID=
SUPABASE_CURRENT_KEY_ID=
CF_DEPLOY_TOKEN_POLICY_JSON=
CONTAINER_IMAGE=
OPS_TOKEN=
EXPECTED_REVISION=0
# Supabase built-in delivery is sufficient only for authorized test recipients.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SMOKE_FACE_PATH=
SMOKE_BODY_PATH=

# Supplied automatically by GitHub Actions, optional for local operator scripts.
GITHUB_REPOSITORY=SaaraCoM/hackathon-Stylingu
GITHUB_OUTPUT=
GITHUB_ENV=

# Registry authentication files must remain in memory on Linux CI runners.
DOCKER_CONFIG=/dev/shm/stylingu-docker
