# Postgres de Supabase (cadena directa, no el pooler en modo transacción).
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
PORT=8080
# Meta Model API. Solo servidor; nunca incluir en frontend.
AI_PROVIDER=meta
MODEL_API_KEY=
# META_AI_API_KEY se admite como alias para instalaciones anteriores.
# AI_PROVIDER=mock permite únicamente pruebas de simulación explícitas.

# Fotos: Supabase Storage. Sin estas claves se usa disco local (solo desarrollo).
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=stylingu-photos

# Configuración de producción; no escribas secretos en este archivo.
PUBLIC_ORIGIN=https://stylingu.example
RELEASE_VERSION=development
ANALYSIS_DAILY_LIMIT=10
# Configura TRUST_PROXY=1 solo tras un proxy de confianza.
TRUST_PROXY=0
# Recuperación: transporte SMTP real pendiente de configurar.
SMTP_URL=
MAIL_FROM=
