# Plantilla de despliegue. El servidor local lee backend/.env.
# No introducir secretos reales en este archivo.
NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://stylingu.example
RELEASE_VERSION=development
TRUST_PROXY=0
DATABASE_URL=
PG_POOL_MAX=5
# Solo desarrollo: puerto del Postgres embebido.
PG_PORT=5433
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=stylingu-photos
AI_PROVIDER=meta
MODEL_API_KEY=
# Alias opcional de MODEL_API_KEY.
META_AI_API_KEY=
ANALYSIS_DAILY_LIMIT=10
SMTP_URL=
MAIL_FROM=
