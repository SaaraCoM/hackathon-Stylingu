{
  "name": "stylingu-backend-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm --prefix backend start",
    "serve": "npm --prefix backend start",
    "jobs": "npm --prefix backend run jobs",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "migrate": "node scripts/migrate.mjs",
    "deploy:dry": "wrangler deploy --dry-run --containers-rollout=none",
    "deploy:preview": "wrangler deploy --name stylingu-preview --secrets-file .env.production",
    "deploy": "wrangler deploy --secrets-file .env.production"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@cf-wasm/photon": "0.4.0",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
