{
  "name": "stylingu-backend-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm --prefix backend start",
    "serve": "npm --prefix backend start",
    "jobs": "npm --prefix backend run jobs",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "migrate": "node scripts/migrate.mjs",
    "deploy:dry": "wrangler deploy --env=\"\" --dry-run",
    "deploy:preview": "wrangler deploy --env staging",
    "deploy": "node -e \"throw new Error('Use the manual Promote workflow after a verified preview.')\""
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "libsodium-wrappers": "0.8.4",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
