{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stylingu",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "StylinguContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STYLINGU_CONTAINER",
        "class_name": "StylinguContainer"
      }
    ]
  },
  "exports": {
    "StylinguContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "RELEASE_VERSION": "cloudflare"
  }
}
